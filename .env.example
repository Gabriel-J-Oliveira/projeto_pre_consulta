DJANGO_SECRET_KEY=gere-uma-chave-local-unica
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DEMO_MEDIA_ROOT=demo_media
DB_BACKEND=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=preconsulta_local
DB_USER=seu_usuario_local
DB_PASSWORD=substitua-por-uma-senha-local
# Desenvolvimento sem PostgreSQL: defina DB_BACKEND=sqlite explicitamente.
# Ao executar em paralelo com a porta 8000, use nomes distintos de cookies:
DJANGO_SESSION_COOKIE_NAME=preconsulta_8001_session
DJANGO_CSRF_COOKIE_NAME=preconsulta_8001_csrf

